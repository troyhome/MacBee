<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The everyday MacBee as shared in the .dmg (Developer ID, hardened runtime, notarized).
     Same as MacBee.entitlements, plus JIT for mpv's LuaJIT, which the hardened runtime blocks otherwise. -->
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.troyhomenchuk.MacBee</string>
	</array>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
